<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <!--
            force="true" na izolacji bazy jest KRYTYCZNE, nie kosmetyczne.
            Bez tego atrybutu PHPUnit ustawia <env> tylko wtedy, gdy dana
            zmienna NIE jest już obecna w środowisku procesu. compose.yaml
            (profil apps) wstrzykuje DB_CONNECTION=pgsql/DB_HOST=postgres
            jako prawdziwe zmienne środowiskowe kontenera — bez force="true"
            te wpisy są po cichu ignorowane, testy łączą się z PRAWDZIWĄ
            bazą deweloperską, a RefreshDatabase ją CZYŚCI między testami.
            Znalezione boleśnie: pierwsze uruchomienie `php artisan test`
            w kontenerze wykasowało dane E2E z realnego Postgresa (RUNBOOK 018).
        -->
        <env name="APP_ENV" value="testing" force="true"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="DB_CONNECTION" value="sqlite" force="true"/>
        <env name="DB_DATABASE" value=":memory:" force="true"/>
        <env name="DB_HOST" value="" force="true"/>
        <env name="DB_URL" value="" force="true"/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
        <!--
            <server> jest DRUGĄ połową izolacji i bez niej force="true" nie wystarcza
            (RUNBOOK 026). <env force="true"> ustawia tylko putenv() i $_ENV —
            NIGDY $_SERVER. A PHP CLI kopiuje zmienne środowiskowe kontenera do
            $_SERVER, Dotenv Laravela czyta $_SERVER jako PIERWSZE źródło. Efekt:
            w kontenerze APP_ENV=local i DB_CONNECTION=pgsql z compose.yaml
            wygrywały z phpunit.xml — testy jechały na prawdziwym Postgresie
            (RefreshDatabase go czyścił), a CSRF nie był wyłączany (419).
            <server> zawsze nadpisuje $_SERVER, atrybut force jest zbędny.
        -->
        <server name="APP_ENV" value="testing"/>
        <server name="DB_CONNECTION" value="sqlite"/>
        <server name="DB_DATABASE" value=":memory:"/>
        <server name="DB_HOST" value=""/>
        <server name="DB_URL" value=""/>
    </php>
</phpunit>
