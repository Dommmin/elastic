# ============================================================================
#  Marketplace Search Platform — konfiguracja lokalna
#  Skopiuj do .env:   cp .env.example .env
#
#  ZASADA: wszystkie wersje w jednym miejscu (docs/07-WERSJE.md).
#  Podbicie wersji = zmiana JEDNEJ linii tutaj, nie polowanie po plikach.
# ============================================================================

COMPOSE_PROJECT_NAME=marketplace

# --- WERSJE (zweryfikowane 2026-08-12, patrz docs/07-WERSJE.md) --------------
ES_VERSION=9.5.1
KIBANA_VERSION=9.5.1
POSTGRES_VERSION=18.4
RABBITMQ_VERSION=4.3.4
REDIS_VERSION=8.8.1
FRANKENPHP_VERSION=1.12.7
PHP_VERSION=8.5
NODE_VERSION=24.19.0

# --- ELASTICSEARCH ----------------------------------------------------------
ES_CLUSTER_NAME=marketplace-local
ELASTIC_PASSWORD=elastic_dev_2026
KIBANA_SYSTEM_PASSWORD=kibana_dev_2026

# Heap JVM na KAŻDY node ES. Dobierz do pamięci przydzielonej Dockerowi
# (Docker Desktop -> Settings -> Resources -> Memory). Sprawdź: make doctor
#
#   Docker VM   Profil                     ES_HEAP   ES_MEM_LIMIT
#   ---------   ------------------------   -------   ------------
#   8 GB        default (1 node)           2g        4g
#   12 GB       default (1 node)           4g        8g
#   20-22 GB    cluster (3 node'y)         3g        6g
#
# ZASADA: heap = max 50% limitu pamięci kontenera (druga połowa jest potrzebna
# Lucene na cache plików). Xms musi równać się Xmx.
ES_HEAP=2g
ES_MEM_LIMIT=4g

# Hasła użytkowników aplikacyjnych (tworzone przez kontener es-setup).
# W module 12 zamienimy je na API keys — tak jak powinno być w produkcji.
ES_CATALOG_PASSWORD=catalog_dev_2026
ES_SEARCHSVC_PASSWORD=searchsvc_dev_2026

# --- POSTGRESQL -------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_dev_2026
# Bazy tworzone przez infra/postgres/init/01-databases.sh
CATALOG_DB=catalog
CATALOG_DB_USER=catalog
CATALOG_DB_PASSWORD=catalog_dev_2026
SEARCHSVC_DB=searchsvc
SEARCHSVC_DB_USER=searchsvc
SEARCHSVC_DB_PASSWORD=searchsvc_dev_2026

# --- RABBITMQ ---------------------------------------------------------------
RABBITMQ_USER=marketplace
RABBITMQ_PASSWORD=rabbit_dev_2026

# --- REDIS ------------------------------------------------------------------
REDIS_PASSWORD=redis_dev_2026

# --- APLIKACJE --------------------------------------------------------------
# Przełącznik z decyzji D-07b — etap 4 wymaga zmierzenia OBU wartości (k6)
# i zapisania wyniku w docs/POMIARY.md.
OCTANE_ENABLED=false
APP_ENV=local
APP_DEBUG=true

# --- PORTY NA HOŚCIE --------------------------------------------------------
ES_PORT=9200
KIBANA_PORT=5601
POSTGRES_PORT=5432
RABBITMQ_PORT=5672
RABBITMQ_UI_PORT=15672
REDIS_PORT=6379
CATALOG_HTTP_PORT=8080
CATALOG_HTTPS_PORT=8443
SEARCH_HTTP_PORT=8081
VITE_PORT=5173
MAILPIT_UI_PORT=8025
