# ============================================================================
#  Niesekretna konfiguracja aplikacji (ETAP D2) — odpowiednik `environment:`
#  z compose.yaml. Kustomize robi z tego ConfigMap `marketplace-config`
#  z HASHEM w nazwie: zmiana tego pliku = nowa nazwa = Deploymenty, które
#  go używają, robią rolling restart same. W compose trzeba było pamiętać
#  o `up -d` z odtworzeniem kontenera.
#
#  Sekrety (hasła, klucze) NIE tutaj — Secret `marketplace-secrets`,
#  tworzony na serwerze przez tools/k3s/secrets.sh z /opt/marketplace/.env.
# ============================================================================

# --- nazwy usług w klastrze (DNS: <service>.marketplace.svc.cluster.local) ---
DB_HOST=postgres
DB_PORT=5432
REDIS_HOST=redis
RABBITMQ_HOST=rabbitmq
# Service tworzony przez ECK dla Elasticsearch o nazwie "marketplace"
ELASTICSEARCH_HOST=http://marketplace-es-http:9200
# Service `catalog-app` — nazwa MUSI być taka: Caddyfile ma blok
# `http://catalog-app` dla wewnętrznego API projekcji (search -> catalog).
CATALOG_INTERNAL_BASE_URL=http://catalog-app

# --- bazy i użytkownicy (nazwy, nie hasła) ---
POSTGRES_USER=postgres
CATALOG_DB=catalog
CATALOG_DB_USER=catalog
SEARCHSVC_DB=searchsvc
SEARCHSVC_DB_USER=searchsvc
RABBITMQ_USER=marketplace
ES_CATALOG_USER=catalog
ES_SEARCHSVC_USER=searchsvc

# --- catalog (Laravel) ---
DB_CONNECTION=pgsql
REDIS_CLIENT=phpredis
SERVER_NAME=:80
APP_ENV=production
APP_DEBUG=false
APP_URL=http://localhost:38080
LOG_CHANNEL=stderr
LOG_LEVEL=info
OCTANE_ENABLED=false

# --- search (Symfony) ---
MAILER_DSN=null://null
DEFAULT_URI=http://localhost
