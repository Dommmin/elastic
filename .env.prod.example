# ============================================================================
#  Marketplace — szablon .env na SERWER (ETAP D)
#
#  NIE kopiuj ręcznie. Na serwerze:  tools/vps/gen-env.sh .env.prod.example .env
#  Każde __GENERATE__ zostanie zastąpione losową wartością (openssl rand).
#  Sekrety powstają TYLKO na serwerze — nie ma ich w gicie, w obrazach,
#  na Macu ani w czacie.
#
#  Hasła są w hex celowo: trafiają do DSN-ów (postgresql://, amqp://),
#  gdzie znaki typu @ / : # rozsypałyby parsowanie URL-a.
# ============================================================================

COMPOSE_PROJECT_NAME=marketplace
# Compose czyta te dwie zmienne z .env — dzięki nim na serwerze wystarczy
# `docker compose ps|logs|exec`, bez powtarzania -f ... --profile ...
COMPOSE_FILE=compose.yaml:compose.prod.yaml
COMPOSE_PROFILES=cluster,apps

# Wersja aplikacji = tag obrazów w GHCR (pełny SHA commita).
# Ustawiane przez `make prod-deploy tag=<sha>`; rollback = starszy SHA.
IMAGE_TAG=main

# --- WERSJE (muszą zgadzać się z .env.example — z nich CI buduje obrazy) -----
ES_VERSION=9.5.1
KIBANA_VERSION=9.5.1
POSTGRES_VERSION=18.4
RABBITMQ_VERSION=4.3.4
REDIS_VERSION=8.8.1
FRANKENPHP_VERSION=1.12.7
PHP_VERSION=8.5
NODE_VERSION=24.19.0

# --- ELASTICSEARCH ----------------------------------------------------------
ES_CLUSTER_NAME=marketplace-vps
ELASTIC_PASSWORD=__GENERATE__
KIBANA_SYSTEM_PASSWORD=__GENERATE__
ES_CATALOG_PASSWORD=__GENERATE__
ES_SEARCHSVC_PASSWORD=__GENERATE__

# Profil pod VPS 24 GB, klaster 3-nodowy (docs/08-PLAN-ETAP-D-VPS.md):
#   16 GB -> 1 node:  ES_HEAP=2g     ES_MEM_LIMIT=4g  (bez --profile cluster)
#   24 GB -> 3 nody:  ES_HEAP=1500m  ES_MEM_LIMIT=3g
#   32 GB -> 3 nody:  ES_HEAP=3g     ES_MEM_LIMIT=6g
ES_HEAP=1500m
ES_MEM_LIMIT=3g

# Klucze szyfrujące Kibany (min. 32 znaki). Stałe między restartami —
# bez tego Kibana gubi zapisane obiekty (alerty, dashboardy).
KIBANA_SECURITY_KEY=__GENERATE__
KIBANA_SAVEDOBJECTS_KEY=__GENERATE__
KIBANA_REPORTING_KEY=__GENERATE__

# --- POSTGRESQL -------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=__GENERATE__
CATALOG_DB=catalog
CATALOG_DB_USER=catalog
CATALOG_DB_PASSWORD=__GENERATE__
SEARCHSVC_DB=searchsvc
SEARCHSVC_DB_USER=searchsvc
SEARCHSVC_DB_PASSWORD=__GENERATE__

# --- RABBITMQ ---------------------------------------------------------------
RABBITMQ_USER=marketplace
RABBITMQ_PASSWORD=__GENERATE__

# --- REDIS ------------------------------------------------------------------
REDIS_PASSWORD=__GENERATE__

# --- APLIKACJE --------------------------------------------------------------
OCTANE_ENABLED=false
APP_ENV=production
APP_DEBUG=false
# Laravel: base64 z 32 losowych bajtów (gen-env.sh rozpoznaje nazwę).
CATALOG_APP_KEY=__GENERATE__
SEARCH_APP_SECRET=__GENERATE__

# --- PORTY (TYLKO 127.0.0.1 na serwerze — dostęp tunelem SSH) ----------------
ES_PORT=9200
KIBANA_PORT=5601
POSTGRES_PORT=5432
RABBITMQ_PORT=5672
RABBITMQ_UI_PORT=15672
REDIS_PORT=6379
CATALOG_HTTP_PORT=8080
CATALOG_HTTPS_PORT=8443
SEARCH_HTTP_PORT=8081
VITE_PORT=5173
MAILPIT_UI_PORT=8025
