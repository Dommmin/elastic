{
  "_meta": { "description": "ECS dla logów aplikacyjnych (Monolog + Caddy). Tworzy obs-setup, ETAP 11." },
  "template": {
    "mappings": {
      "dynamic_templates": [
        {
          "strings_as_keyword": {
            "match_mapping_type": "string",
            "mapping": { "type": "keyword", "ignore_above": 1024 }
          }
        }
      ],
      "properties": {
        "@timestamp": { "type": "date" },
        "message": { "type": "match_only_text" },
        "tags": { "type": "keyword" },
        "log": {
          "properties": {
            "level": { "type": "keyword" },
            "logger": { "type": "keyword" }
          }
        },
        "trace": { "properties": { "id": { "type": "keyword" } } },
        "service": { "properties": { "name": { "type": "keyword" } } },
        "event": {
          "properties": {
            "dataset": { "type": "keyword" },
            "duration": { "type": "long" },
            "original": { "type": "keyword", "index": false, "doc_values": false }
          }
        },
        "http": {
          "properties": {
            "request": { "properties": { "method": { "type": "keyword" } } },
            "response": { "properties": { "status_code": { "type": "long" } } }
          }
        },
        "url": {
          "properties": {
            "original": { "type": "keyword", "ignore_above": 2048 },
            "path": { "type": "keyword", "ignore_above": 2048 }
          }
        },
        "error": {
          "properties": {
            "type": { "type": "keyword" },
            "message": { "type": "match_only_text" },
            "stack_trace": { "type": "match_only_text" }
          }
        },
        "labels": { "type": "flattened", "ignore_above": 8191 },
        "app": {
          "properties": {
            "context": { "type": "flattened", "ignore_above": 8191 },
            "extra": { "type": "flattened", "ignore_above": 8191 }
          }
        }
      }
    }
  }
}
