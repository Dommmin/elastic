{
  "uid": "marketplace-overview",
  "title": "Marketplace: przegląd",
  "description": "Alerty, outbox, kolejki RabbitMQ, HTTP catalog i failure transport.",
  "tags": [
    "marketplace"
  ],
  "schemaVersion": 41,
  "version": 1,
  "editable": false,
  "timezone": "browser",
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "links": [
    {
      "title": "Logi w Kibanie",
      "type": "link",
      "icon": "doc",
      "url": "http://localhost:5601/app/discover#/?_g=(time:(from:'${__from:date:iso}',to:'${__to:date:iso}'))&_a=(dataSource:(dataViewId:logs-app,type:dataView))",
      "targetBlank": true,
      "tooltip": "Discover (data view logs-app) z bieżącym zakresem czasu"
    }
  ],
  "panels": [
    {
      "id": 1,
      "title": "Alerty",
      "type": "alertlist",
      "datasource": {
        "type": "alertmanager",
        "uid": "alertmanager"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 7
      },
      "targets": [],
      "description": "Aktywne alerty z Alertmanagera.",
      "options": {
        "alertInstanceLabelFilter": "",
        "alertName": "",
        "datasource": "alertmanager",
        "groupBy": [],
        "groupMode": "default",
        "maxItems": 20,
        "sortOrder": 1,
        "stateFilter": {
          "firing": true,
          "pending": true,
          "noData": false,
          "normal": false,
          "error": true
        },
        "viewMode": "list",
        "showInstances": true
      }
    },
    {
      "id": 2,
      "title": "Outbox: zaległość",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 7,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "catalog_outbox_pending",
          "legendFormat": "oczekujące",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "description": "Liczba zdarzeń outboxu czekających na publikację."
    },
    {
      "id": 3,
      "title": "Outbox: wiek najstarszego",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 7,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "catalog_outbox_oldest_pending_age_seconds",
          "legendFormat": "wiek",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "description": "Rośnie, gdy relay nie nadąża lub stoi.",
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "title": "RabbitMQ: wiadomości gotowe",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 15,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "rabbitmq_detailed_queue_messages_ready",
          "legendFormat": "{{queue}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "description": "Zaległość per kolejka."
    },
    {
      "id": 5,
      "title": "RabbitMQ: odpytywanie kolejek",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 15,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "rate(rabbitmq_detailed_queue_get_empty_total[1m]) + rate(rabbitmq_detailed_queue_get_ack_total[1m])",
          "legendFormat": "{{queue}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "description": "Messenger pobiera przez basic.get, więc liczba konsumentów jest zawsze 0; żywotność konsumenta widać po tempie odpytywań.",
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      }
    },
    {
      "id": 6,
      "title": "Kolejki DLQ",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 23,
        "w": 8,
        "h": 6
      },
      "targets": [
        {
          "expr": "sum by (queue) (rabbitmq_detailed_queue_messages{queue=~\".+\\\\.dlq\"})",
          "legendFormat": "{{queue}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "description": "Wiadomości w kolejkach martwych listów.",
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 7,
      "title": "Failure transport (search)",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 8,
        "y": 23,
        "w": 8,
        "h": 6
      },
      "targets": [
        {
          "expr": "search_messenger_failed_messages",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "description": "Wiadomości w failure transporcie Messengera w search.",
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 8,
      "title": "HTTP catalog: req/s per kod",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 29,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum by (code) (rate(caddy_http_request_duration_seconds_count{host!=\"_other\"}[1m]))",
          "legendFormat": "{{code}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "description": "Z metryk Caddy (etykiety host, code). Bez host=_other, czyli scrape Prometheusa na porcie 2020.",
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      }
    },
    {
      "id": 9,
      "title": "HTTP catalog: p95",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 29,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(caddy_http_request_duration_seconds_bucket{host!=\"_other\"}[5m])))",
          "legendFormat": "p95",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "description": "p95 czasu odpowiedzi z histogramu Caddy (bez scrape na porcie 2020, host=_other).",
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      }
    }
  ]
}