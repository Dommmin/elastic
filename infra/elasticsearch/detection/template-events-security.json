{
  "index_patterns": [
    "events-security-*"
  ],
  "data_stream": {},
  "priority": 200,
  "template": {
    "settings": {
      "index.number_of_shards": 1,
      "index.number_of_replicas": 1,
      "index.lifecycle.name": "events-security",
      "index.default_pipeline": "events-security"
    },
    "mappings": {
      "dynamic": "strict",
      "properties": {
        "@timestamp": {
          "type": "date"
        },
        "event": {
          "properties": {
            "id": {
              "type": "keyword"
            },
            "type": {
              "type": "keyword"
            },
            "ingested": {
              "type": "date"
            }
          }
        },
        "offer": {
          "properties": {
            "id": {
              "type": "keyword"
            },
            "old_price_cents": {
              "type": "long"
            },
            "new_price_cents": {
              "type": "long"
            },
            "change_pct": {
              "type": "scaled_float",
              "scaling_factor": 100
            }
          }
        },
        "product": {
          "properties": {
            "id": {
              "type": "keyword"
            },
            "popularity": {
              "type": "double"
            }
          }
        },
        "seller": {
          "properties": {
            "id": {
              "type": "keyword"
            }
          }
        },
        "user": {
          "properties": {
            "id": {
              "type": "keyword"
            },
            "account_age_hours": {
              "type": "integer"
            }
          }
        },
        "review": {
          "properties": {
            "id": {
              "type": "keyword"
            },
            "rating": {
              "type": "byte"
            }
          }
        },
        "client": {
          "properties": {
            "ip_hash": {
              "type": "keyword"
            },
            "ip_prefix": {
              "type": "keyword"
            }
          }
        },
        "user_agent": {
          "properties": {
            "original": {
              "type": "keyword",
              "ignore_above": 256
            }
          }
        },
        "trace": {
          "properties": {
            "id": {
              "type": "keyword"
            }
          }
        },
        "labels": {
          "properties": {
            "synthetic": {
              "type": "boolean"
            }
          }
        }
      }
    }
  }
}
