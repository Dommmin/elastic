{
  "index_patterns": ["events-user-*"],
  "data_stream": {},
  "priority": 200,
  "template": {
    "settings": {
      "index.number_of_shards": 1,
      "index.number_of_replicas": 1,
      "index.lifecycle.name": "events-user",
      "index.default_pipeline": "events-ingested"
    },
    "mappings": {
      "dynamic": "strict",
      "properties": {
        "@timestamp": { "type": "date" },
        "event": {
          "properties": {
            "id": { "type": "keyword" },
            "type": { "type": "keyword" },
            "ingested": { "type": "date" }
          }
        },
        "session": { "properties": { "id": { "type": "keyword" } } },
        "user": { "properties": { "id": { "type": "keyword" } } },
        "search": {
          "properties": {
            "id": { "type": "keyword" },
            "query": { "type": "keyword" },
            "query_raw": { "type": "text" },
            "total_hits": { "type": "integer" },
            "results": { "type": "keyword" },
            "sort": { "type": "keyword" },
            "filters": { "type": "flattened" }
          }
        },
        "product": { "properties": { "id": { "type": "keyword" } } },
        "offer": { "properties": { "id": { "type": "keyword" } } },
        "seller": { "properties": { "id": { "type": "keyword" } } },
        "click": { "properties": { "position": { "type": "integer" } } },
        "order": {
          "properties": {
            "ids": { "type": "keyword" },
            "amount_cents": { "type": "long" }
          }
        },
        "trace": { "properties": { "id": { "type": "keyword" } } }
      }
    }
  }
}
