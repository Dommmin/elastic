# ============================================================================
#  Atrapy zmiennych TYLKO dla `cache:warmup` w buildzie obrazu search (prod).
#
#  Kompilacja kontenera DI Symfony sprawdza, czy zmienne z %env()% ISTNIEJĄ
#  (wartości rozwiązuje dopiero w runtime). Ten plik jest montowany
#  `RUN --mount=type=bind` na czas jednej komendy — NIE trafia do obrazu.
#  Prawdziwe wartości daje compose (compose.yaml + compose.prod.yaml).
#  Zero sekretów: to są celowo nieprawdziwe adresy i hasła.
# ============================================================================
APP_SECRET=build-only-not-a-secret
DEFAULT_URI=http://build.invalid
MAILER_DSN=null://null
DATABASE_URL=postgresql://build:build@build.invalid:5432/build?serverVersion=18.4.0
MESSENGER_TRANSPORT_DSN=amqp://build:build@build.invalid:5672/%2f
ELASTICSEARCH_HOST=http://build.invalid:9200
ELASTICSEARCH_USER=build
ELASTICSEARCH_PASSWORD=build
CATALOG_INTERNAL_BASE_URL=http://build.invalid
