# ============================================================================
#  Caddyfile dla FrankenPHP — aplikacja catalog (Laravel + Inertia/Vue)
#
#  Caddy jest tu serwerem HTTP, a PHP działa jako jego moduł (jeden proces).
#  Certyfikat dla *.localhost wystawia wewnętrzne CA Caddy'ego — przy pierwszym
#  wejściu przeglądarka poprosi o zaufanie. To normalne i lokalne.
# ============================================================================

{
	# Ogranicza automatyczne HTTPS do domen lokalnych — bez prób kontaktu
	# z Let's Encrypt (co lokalnie i tak by się nie udało).
	local_certs

	# Metryki serwera HTTP (caddy_http_*), z podziałem na host (per_host), żeby
	# odróżnić ruch publiczny (catalog.localhost) od wewnętrznego (catalog-app).
	# Samo włączenie niczego nie wystawia — endpoint to osobny blok :2020 niżej.
	metrics {
		per_host
	}

	frankenphp {
		# Worker mode włączamy zmienną OCTANE_ENABLED (decyzja D-07b).
		# Odkomentujemy w ETAPIE 4, po zmierzeniu wariantu klasycznego.
		# worker {
		#     file ./public/frankenphp-worker.php
		#     num 4
		# }
	}
}

{$SERVER_NAME:catalog.localhost} {
	log {
		# Logi w JSON, bo mają trafić do Elasticsearcha w ETAPIE 11 (ECS).
		# Format tekstowy wymagałby parsowania grokiem — po co, skoro można od razu.
		output stdout
		format json
	}

	encode zstd gzip

	# Która wersja odpowiada? SHA commita wbudowany w obraz prod (ETAP D).
	# W dev zmiennej nie ma — wtedy "dev". `curl -sI .../up | grep -i x-app-version`
	header X-App-Version {$APP_VERSION:dev}

	# --- Vite dev server (HMR) --------------------------------------------
	# W dev assety serwuje Vite, nie Caddy. Bez tego proxy w przeglądarce
	# musiałbyś żonglować dwoma portami, a HMR przez WebSocket by nie działał.
	#
	# PUŁAPKA: jeśli strona działa, ale zmiany w komponentach Vue się nie
	# odświeżają i konsola pokazuje błąd WebSocketa — sprawdź `server.hmr.host`
	# w vite.config.js. Musi wskazywać domenę widzianą przez PRZEGLĄDARKĘ,
	# nie nazwę kontenera. (Zapisane w RUNBOOK-u.)
	@vite path /@vite/* /@id/* /resources/* /node_modules/* /@fs/*
	reverse_proxy @vite {$VITE_DEV_SERVER:http://catalog-vite:5173}

	# Klient HMR Vite łączy się WebSocketem.
	@viteHmr {
		header Connection *Upgrade*
		header Upgrade websocket
	}
	reverse_proxy @viteHmr {$VITE_DEV_SERVER:http://catalog-vite:5173}

	# --- Tunel błędów z przeglądarki do GlitchTipa (ETAP 11b, ADR-0009) -------
	#
	# SDK w przeglądarce (opcja `tunnel`) wysyła kopertę na to samo origin, a Caddy
	# przekazuje ją do GlitchTipa. Dzięki temu GlitchTip nie musi być publiczny (na VPS
	# jest tylko za tunelem SSH), nie ma CORS ani mixed content, a adblockery nie
	# widzą domeny `sentry`.
	#
	# To NIE jest otwarty przekaźnik: cel (projekt frontendu i jego klucz) jest
	# wpisany tu na sztywno ze zmiennych środowiskowych i nie zależy od DSN w kopercie.
	# Przez /_errors da się pisać wyłącznie do projektu `catalog-frontend`.
	# Ciało ograniczone do 1 MB (bez Content-Encoding); ciasteczka, autoryzacja i X-Sentry-Auth
	# nie idą dalej. Martwy GlitchTip daje szybkie 502, zawieszony 504 po 3 s (SDK
	# przeglądarki to ignoruje).
	# Pusty GLITCHTIP_FRONTEND_KEY (np. prod bez GlitchTipa) = tunel wyłączony, 204.
	@errorsDisabled expression `"{$GLITCHTIP_FRONTEND_KEY:}" == ""`
	@errorsNotPost not method POST
	# Limit 1 MB dotyczy bajtów po kompresji, a SDK przeglądarki nie kompresuje,
	# więc skompresowane ciało odrzucamy (bomba gzip w kontenerze z limitem 512m).
	@errorsEncoded header Content-Encoding *
	handle /_errors {
		respond @errorsDisabled 204
		respond @errorsNotPost 405
		respond @errorsEncoded 415
		request_body {
			max_size 1MB
		}
		rewrite * /api/{$GLITCHTIP_FRONTEND_PROJECT_ID:2}/envelope/?sentry_key={$GLITCHTIP_FRONTEND_KEY:}
		reverse_proxy {$GLITCHTIP_UPSTREAM:glitchtip:8000} {
			header_up Host {upstream_hostport}
			header_up -Cookie
			header_up -Authorization
			header_up -X-Sentry-Auth
			transport http {
				dial_timeout 1s
				response_header_timeout 3s
			}
		}
	}

	root * public/

	# Pliki statyczne obsługuje Caddy — PHP nie jest w ogóle uruchamiane.
	# To jedna z przewag nad php-fpm, gdzie każdy request przechodzi przez PHP.
	file_server

	# /prometheus (metryki aplikacji Laravel) jest tylko dla Prometheusa w sieci
	# dockerowej — ADR-0005, zasada 4. Publicznie ma dawać 404, żeby nikt z
	# zewnątrz nie czytał wewnętrznych liczników. Prometheus czyta go z portu
	# 2020 (blok na końcu pliku). Kolejność w pliku nie ma znaczenia: Caddy
	# sam sortuje dyrektywy i `respond` wykonuje się przed `php_server`.
	# `/index.php/prometheus` też: php_server dzieli ścieżkę na `.php`, więc
	# Laravel dostaje PATH_INFO `/prometheus` i bez tych wariantów oddałby
	# metryki na publicznym hoście.
	@metrics path /prometheus /prometheus/* /index.php/prometheus /index.php/prometheus/*
	respond @metrics 404

	php_server
}

# --- Ruch WEWNĄTRZ sieci dockerowej (search-service -> catalog) -------------
#
# DLACZEGO osobny blok, nie ten sam co wyżej: powyższy site block wymusza
# automatyczne przekierowanie HTTP -> HTTPS z certyfikatem lokalnego CA
# wystawionym dla identyfikatora "catalog.localhost". search-consumer łączy
# się po NAZWIE SERWISU DOCKEROWEGO (`catalog-app`), więc SNI/Host nigdy nie
# będzie pasować do tego certyfikatu — handshake TLS by się wywalał.
#
# Zamiast zmuszać wewnętrzny ruch serwis-serwis do TLS z certyfikatem
# wystawionym pod inną nazwę (i tak nieprzydatnym poza tą siecią), ten blok
# słucha zwykłego HTTP na porcie 80 pod nazwą kontenera. UWAGA: port 80
# kontenera JEST opublikowany (dev: 127.0.0.1:${CATALOG_HTTP_PORT}, prod: na
# serwerze), więc o tym bloku decyduje tylko nagłówek Host — kto go sfałszuje
# (`Host: catalog-app`), ten tu trafi z zewnątrz. Dlatego niczego wrażliwego
# (metryki) tu nie wystawiamy; metryki mają osobny, nieopublikowany port 2020
# (blok na końcu pliku). Zamierzony ruch serwis-serwis
# nigdy nie opuszcza sieci `marketplace`, więc dla NIEGO brak TLS nie jest
# ryzykiem; ruch z zewnątrz przez sfałszowany Host to osobna sprawa.
#
# Świadomie tylko prefiks /api/ — to jedyne, czego wewnętrzni klienci
# (search-service, ETAP 6) powinni móc dotknąć.
#
# UWAGA (błąd, który tu był): samo `catalog-app:80` (bez schematu) NIE
# wystarczyło, żeby wyłączyć automatyczne HTTPS. Gdy w Caddyfile jest choć
# jeden site z automatycznym HTTPS (blok wyżej), Caddy instaluje GLOBALNY
# listener przekierowujący port 80 -> 443 dla WSZYSTKICH hostów, zanim
# w ogóle dojdzie do routingu po nazwie site'a. Realny objaw: request
# wychodził z Symfony jako `http://catalog-app/...`, a błąd TLS przychodził
# dla `https://catalog-app/...` — Caddy po cichu podmieniał schemat.
# Naprawa: JAWNY schemat `http://` w adresie site'a. To jedyny pewny sposób
# na całkowite wypisanie się z automatycznego HTTPS dla danego bloku.
http://catalog-app {
	# Access log także tu (ETAP 11): bez niego żądanie projekcji
	# search -> catalog (/api/internal/products/…/projection) nie miało
	# śladu w ES, choć niesie ten sam trace.id (traceparent -> X-Trace-Id).
	# Znalezione na żywym stacku w Task 12.
	log {
		output stdout
		format json
	}

	route /api/* {
		root * public/
		php_server
	}
	# Webhook bramki płatności (worker -> catalog-app, podpis HMAC w nagłówku).
	route /webhooks/* {
		root * public/
		php_server
	}
	respond 404
}

# --- Metryki (Caddy/FrankenPHP + aplikacja) tylko na porcie 2020 -----------
#
# DLACZEGO osobny port :2020, a nie admin API na :2019: admin API pozwala
# ZMIENIAĆ konfigurację serwera (POST /load, /config), więc wystawianie go
# Prometheusowi byłoby dawaniem prawa zapisu komuś, kto ma tylko czytać liczby.
#
# DLACZEGO nie w bloku `http://catalog-app` (port 80): port 80 kontenera jest
# opublikowany na hosta, a o wyborze bloku decyduje nagłówek Host, który
# klient może sfałszować (`curl -H 'Host: catalog-app' localhost:...`). Metryki
# w tym bloku byłyby więc osiągalne z zewnątrz sieci dockerowej. Port 2020 nie
# jest nigdzie publikowany (brak w `ports:` w compose*.yaml) — dostęp ma tylko
# sieć `marketplace`, i to jest właściwa ochrona, nie nazwa hosta.
#
# Prometheus scrape'uje: catalog-app:2020/metrics (Caddy: caddy_http_*,
# frankenphp_*) i catalog-app:2020/prometheus (aplikacja Laravel).
#
# Jawny `http://` z tego samego powodu co przy `http://catalog-app`: bez
# schematu Caddy włączyłby automatyczne HTTPS z certyfikatem lokalnego CA,
# a scraper łączy się zwykłym HTTP.
http://:2020 {
	route /metrics {
		metrics
	}
	route /prometheus {
		root * public/
		php_server
	}
	respond 404
}
